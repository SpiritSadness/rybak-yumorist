# Copy to .env and fill in
BOT_TOKEN=
CHAT_ID=
SOCKS_PROXY=

# --- Ops: backup + watchdog alerts (optional) ---
# If you don't need backups/alerts (e.g. home PC), disable all three:
# BACKUP_ENABLED=false
# WATCHDOG_ENABLED=false
# TELEGRAM_NOTIFY_ENABLED=false
#
# Quick off on server: bash scripts/ops-disable.sh

# Who gets backup/watchdog reports (leave empty = no Telegram reports)
# BACKUP_NOTIFY_USERNAME=
# BACKUP_NOTIFY_CHAT_ID=123456789

# Backup directory (default: ~/backups/rybak-yumorist)
# BACKUP_ROOT=
# BACKUP_MIRROR_PATH=

# Watchdog: min interval between repeat alerts (ms), default 30 min
# WATCHDOG_COOLDOWN_MS=1800000
