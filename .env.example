# Copy to .env and fill in
BOT_TOKEN=
CHAT_ID=
SOCKS_PROXY=

# Who gets backup/watchdog reports (Telegram @username or leave empty)
# BACKUP_NOTIFY_USERNAME=
# BACKUP_NOTIFY_CHAT_ID=123456789

# Backup root (default: ~/backups/rybak-yumorist)
# BACKUP_ROOT=
# BACKUP_MIRROR_PATH=

# Watchdog: min interval between repeat alerts (ms), default 30 min
# WATCHDOG_COOLDOWN_MS=1800000
