# Copy to .env and fill in
BOT_TOKEN=
CHAT_ID=

# Proxy (pick one working provider). Prod VPS uses SOCKS_PROXY.
# Code may try HTTP on the same host:port for Proxy6-style endpoints.
SOCKS_PROXY=socks5://USER:PASS@HOST:PORT
# HTTP_PROXY=http://USER:PASS@HOST:PORT

# Telegram resilience
# TELEGRAM_RECONNECT_MS=60000
# TELEGRAM_POLL_STALE_MS=30000
# TELEGRAM_STARTUP_RETRY_MS=15000

# Schedule (MSK slots: 4, 7, 9, 14, 18, 23)
# SCHEDULE_CATCHUP_MINUTES=45
# SCHEDULE_QUIET_AFTER_HOUR=22
# SCHEDULE_BACKFILL=false
# OUTBOX_RETRY_MS=60000

NODE_ENV=production

# --- Ops: backup + watchdog alerts (optional) ---
# On VPS you can keep these off to avoid alert spam:
BACKUP_ENABLED=false
WATCHDOG_ENABLED=false
TELEGRAM_NOTIFY_ENABLED=false
#
# Quick off on server: bash scripts/ops-disable.sh
# Quick on:            bash scripts/ops-enable.sh

# Who gets backup/watchdog reports (leave empty = no Telegram reports)
# BACKUP_NOTIFY_USERNAME=
# BACKUP_NOTIFY_CHAT_ID=123456789

# Backup directory (default: ~/backups/rybak-yumorist)
# BACKUP_ROOT=
# BACKUP_MIRROR_PATH=

# Watchdog: min interval between repeat alerts (ms), default 30 min
# WATCHDOG_COOLDOWN_MS=1800000
